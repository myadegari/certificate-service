# certificate-service environment template — copy to `.env` and fill in.
# NEVER commit real secrets. Values must match the Next.js app where noted
# (shared MongoDB + shared Alarik buckets).

# --- RabbitMQ ------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=
RABBITMQ_PASS=
RABBITMQ_JOB_QUEUE=certificate_jobs

# --- Redis ---------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MongoDB (same database as the Next.js app) ---------------
# Must point at the same instance/credentials as MONGODB_URL in
# personnel-certification/.env
MONGODB_URI=mongodb://user:pass@127.0.0.1:27017/?authSource=admin
MONGODB_DB_NAME=certification

# --- Object storage: Alarik (same values as the Next.js app) --
# STORAGE_ENDPOINT/ACCESS_KEY/SECRET_KEY/REGION must match
# personnel-certification/.env exactly.
STORAGE_ENDPOINT=http://127.0.0.1:8080
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Public base URL used to rewrite presigned URLs for browsers
# (must match STORAGE_PUBLIC_URL in the Next.js app; may be empty)
STORAGE_PUBLIC_URL=
CERTIFICATE_BUCKET=certificate

# --- PDF conversion -------------------------------------------
# Path to soffice binary; auto-detected from PATH when empty.
# Windows dev example: C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_PATH=

# --- Status webhook (worker → Next.js) ------------------------
# HMAC-SHA256 secret used to sign certificate status callbacks. Must
# match WEBHOOK_SECRET in personnel-certification/.env.
WEBHOOK_SECRET=
# Full URL the worker POSTs certificate status updates to. Leave empty
# to disable webhooks (Next.js then relies on the MongoDB job_statuses
# fallback). Docker compose sets this to
# http://nextjs:3000/api/certificates/webhook
NEXT_WEBHOOK_URL=

# --- HTTP ------------------------------------------------------
# Comma-separated origins, or * for any (default)
CORS_ALLOW_ORIGINS=*

# --- Internal API ----------------------------------------------
# Shared secret required as the X-Internal-Token header on
# /certificates/generate. Must match MICROSERVICE_TOKEN in the
# Next.js app (docker-compose injects it from the root .env).
# Leave empty only for local dev.
INTERNAL_API_TOKEN=
